# AgentFlow Backend - Prod Env Template
# Copy to .env and fill with real values (see ~/Downloads/CODING/CONFIG/global-env.env for vault)
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
FRONTEND_URL=https://agentflow.pages.dev,https://agentflow-auth.pages.dev
JWT_SECRET=change-me-to-32+chars-random-hex
# Supabase (optional - if set, DB + auth use Supabase, else file fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Google OAuth (optional — enables "Continue with Google" on /auth and vault)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials (type: Web application)
# Add authorized origins: https://agentflow-auth.pages.dev, https://agentflow-hackathon.pages.dev, http://localhost:5173, http://localhost:5174
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
